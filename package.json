{
  "name": "growtrack",
  "version": "0.1.0",
  "private": true,
  "description": "Multichain wallet intelligence API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "npm run build:api",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "next build web",
    "dev:web": "next dev web -p 3001",
    "start:web": "next start web -p 3001",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit && npm run typecheck:web",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.2",
    "@blockshake/defly-connect": "^1.2.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/sensible": "^6.0.3",
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@galaxypay/lute-connect": "^3.0.1",
    "@perawallet/connect": "^1.6.1",
    "@prisma/client": "^6.4.1",
    "@x402-avm/core": "^2.6.1",
    "@x402-avm/express": "^2.6.1",
    "algosdk": "^3.7.0",
    "bullmq": "^5.41.9",
    "decimal.js": "^10.5.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "framer-motion": "^13.4.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.25",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "viem": "^2.23.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.0.5",
    "autoprefixer": "^10.6.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.5.0",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.19",
    "testcontainers": "^10.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
