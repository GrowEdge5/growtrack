NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://growtrack:growtrack@localhost:5432/growtrack?schema=public
REDIS_URL=redis://localhost:6379
# Comma-separated allowed browser origins. A deploy serves the SPA and the API from
# ONE root domain (the facilitator forbids splitting one payTo across domains), while
# local development calls the same API from localhost.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
CACHE_TTL_SECONDS=300
WALLET_FRESHNESS_SECONDS=900
PROVIDER_TIMEOUT_MS=10000
EVM_RPC_URL=https://ethereum-rpc.publicnode.com
EVM_CHAIN_ID=1
EVM_CHAIN_NAME=ethereum
ALGORAND_API_URL=https://mainnet-api.algonode.cloud
ALGORAND_CHAIN_NAME=algorand
# Solana JSON-RPC. The public mainnet RPC needs no key; move to a dedicated provider
# if report traffic starts hitting its rate limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_CHAIN_NAME=solana
# SPL token metadata (symbol/name). Solana has no on-chain ticker, and balances never
# depend on this list — mints absent from it are treated as unverified airdrops and
# excluded from holdings, with an explicit count reported instead of a silent trim.
SOLANA_TOKEN_LIST_URL=https://lite-api.jup.ag/tokens/v2/tag?query=verified
# Esplora-compatible Bitcoin REST base. blockstream.info is the verified-working one.
BITCOIN_API_URL=https://blockstream.info/api
# Optional second base, tried only when the primary fails.
# BITCOIN_FALLBACK_API_URL=https://mempool.space/api
BITCOIN_CHAIN_NAME=bitcoin
PRICE_API_BASE_URL=https://coins.llama.fi
PRICE_TIMEOUT_MS=8000

# --- x402 micropayments (GoPlausible facilitator) ---
# Master switch. Leave false for local dev/test (free path). Set true on a deploy to
# gate the paid routes. When true, X402_PAY_TO is required or startup fails.
X402_ENABLED=false
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz
# CAIP-2 network id. Testnet shown; mainnet = algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
X402_NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# USDC ASA id. Testnet = 10458941, mainnet = 31566704.
X402_ASSET_ID=10458941
X402_ASSET_DECIMALS=6
# Human-readable asset name shown in the Bazaar listing (extra.name).
X402_ASSET_NAME=USDC
# NOTE: there is deliberately no X402_PRICE_ATOMIC. This is a Composite entry, so each
# endpoint carries its own price in src/modules/payments/domain/paid-resource.ts
# ($0.01 live snapshot, $0.02 portfolio totals, $0.05 full report). All of them settle
# to the single X402_PAY_TO below, which is what rolls their volume up as one merchant.
# PUBLIC recipient address (required when X402_ENABLED=true). Never a private key.
# Leave unset (commented) for local dev; set a real PUBLIC Algorand address before X402_ENABLED=true.
# X402_PAY_TO=
# Facilitator's PUBLIC fee-payer (gasless settlement). Default is the live signer.
X402_FEE_PAYER=ZMFK2OI7ZBD2U27ISERZC4S6LKM6WMFJPZQ4MYNJDZ2VNBNMBA67RA22AA
X402_MAX_TIMEOUT_SECONDS=300
X402_TAG=x402-global-challenge
# Canonical PUBLIC origin of the deployment, no path. Each paid resource's Bazaar
# listing URL is derived as this origin + the resource's own path, so every endpoint
# advertises the ONE root domain the merchant is registered against. Set on a deploy;
# leave unset locally (the 402 then carries no resource descriptor).
# X402_PUBLIC_BASE_URL=https://growtrack.xyz
